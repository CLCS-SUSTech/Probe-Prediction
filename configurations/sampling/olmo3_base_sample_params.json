            "max_tokens": 1024,
            "n": 8,
            "stop_words": ["\n\nQ:", "\n\nQuestion"]
        },
        "human_eval": {
            "max_tokens": 1024,
            "n": 8,
            "stop_words": ["\nclass", "\ndef", "\n#", "\nif", "\nprint"]
        },
        "mbpp": {
            "max_tokens": 1024,
            "n": 8,
            "stop_words": ["[DONE]"]
        },
        "mmlu": {
            "n": 8,
            "stop_words": ["\n\nQuestion", "\n\nQ:"]
        },
        "bbh": {
            "max_tokens": 2048,
            "n": 8,
            "stop_words": ["\n\nQUESTION", "\n\nQ:", "\n\nQuestion"]
