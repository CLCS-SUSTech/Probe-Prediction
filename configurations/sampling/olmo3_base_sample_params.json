{
    "default_top_p": 0.6,
    "default_temperature": 0.6,
    "default_k": 1,
    "default_n": 8,
    "default_max_tokens": 512,
    "default_stop_words": ["\n\nQuestion", "\n\nQ:"],
    "datasets": {
        "math": {
            "max_tokens": 2048,
            "n": 8,
            "stop_words": ["\n\nQuestion:", "\n\nQ:"]
